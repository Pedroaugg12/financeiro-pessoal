# Opcional. Se não definir, o app usa os valores padrão em src/lib/supabase.js.
# A chave "publishable" da Supabase é pública por design — ela roda no navegador.
# Quem protege os dados é o RLS (Row Level Security), não o segredo da chave.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
